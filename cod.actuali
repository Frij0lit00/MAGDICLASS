	scanf("%d", &n);
	return n;
}
int menusub(void){
	int op;
	printf("\n Ingrese una opcion de la FUNCIÓN : \n");
	printf("\n 1_ Buscar datos \n");
	printf("\n 2_ Contar datos \n");
	printf("\n 3_ Remplazar Datos \n");
	
	printf("\n 5_ Ordenar Datos \n");
	scanf("%d", &op);
	return op;
}
void liberarTodo(struct Dato **ptr){
    struct Dato *ptrAux, *temp;

    if(*ptr == NULL){
        puts("no hay memoria para liberar");
        return;
    }

    ptrAux = *ptr;
    while(ptrAux != NULL){
        temp = ptrAux;
        ptrAux = ptrAux->ptrSig;
        free(temp);
    }

    *ptr = NULL;
    puts("Se liberaron todos los nodos");
}


void ordenarDatos(struct Dato *ptr){
    struct Dato *i, *j;/* con ayuda de estos dos podemos recorrernos en los nodosi  recorre la lista (nodo actual)j 
						 compara con los siguientes nodostemp, variable auxiliar para intercambiar valores*/
	int temp;

    if(ptr == NULL){
        printf("Lista vacia\n");
        return;
    }

    for(i = ptr; i != NULL; i = i->ptrSig){
        for(j = i->ptrSig; j != NULL; j = j->ptrSig){// si la lista esta vacia no hay nada por que ordenar 
            if(i->d > j->d){ // aqui va lo del orden pero de manera ascendente
                temp = i->d; //Si el dato actual (i) es mayor que el siguiente (j) entonces estan desordenados
                i->d = j->d;
                j->d = temp;
            }
        }
    }

    printf("Datos ordenados correctamente\n");
}

void reemplazardato(struct Dato *ptr){
    int b, nuevo;
    int enc = 0;

    if(ptr == NULL){
        printf("Lista vacia\n");
        return;
    }

    printf("Ingrese el dato a reemplazar: ");
    scanf("%d", &b);

    printf("Ingrese el nuevo dato: ");
    scanf("%d", &nuevo);

    while(ptr != NULL){
        if(ptr->d == b){
            ptr->d = nuevo;
            enc = 1;
        }
        ptr = ptr->ptrSig;
    }

    if(enc){
        printf("Dato reemplazado correctamente\n");
    } else {
        printf("No se pudo encontrar el dato\n");
    }
}

void buscarDatos(struct Dato *ptr){
    int bus;
    int posi = 1;
    int encontrado = 0;

    if(ptr == NULL){
        printf("Lista vacia\n");
        return;
    }

    printf("Ingrese el dato a buscar: ");
    scanf("%d", &bus);

    while(ptr != NULL){
        if(ptr->d == bus){
            printf("Dato encontrado en la posicion %d\n", posi);
            encontrado = 1;
        }
        ptr = ptr->ptrSig;
        posi++;
    }

    if(!encontrado){
        printf("Dato no encontrado\n");
    }
}
struct Dato* crearDato(void);
void mostrarDato(struct Dato *ptr);
void liberarDato(struct Dato **ptr);

