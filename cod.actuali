void liberarDato(struct Dato **ptr){
	struct Dato *ptrAux;

	// Si ya hay memoria la liberamos primero

	if(*ptr == NULL){
		printf("no hay datos para liberar\n");
	} else {
		if((*ptr)->ptrSig == NULL){ 
			free(*ptr); 
			*ptr = NULL; 
		} else {
			ptrAux = *ptr; 
			while(ptrAux->ptrSig->ptrSig != NULL){ 
				ptrAux = ptrAux->ptrSig; 
			}
			free(ptrAux->ptrSig); 
			ptrAux->ptrSig = NULL;
		}
	}
}

struct Dato * crearDato(void){
	
	struct Dato *ptrTemp; 
	ptrTemp = (struct Dato *)malloc(sizeof(struct Dato)); 
	if(ptrTemp == NULL){
		printf("error no asigno bien la memoria\n");
		return NULL;
	} else {
		printf("Ingrese un dato ");
		scanf("%d", &ptrTemp->d); 
		ptrTemp->ptrSig = NULL;
		return ptrTemp; 
	}
}

void mostrarDato(struct Dato *ptr){
	while(ptr != NULL){
		printf("%d\n", ptr->d); 
		ptr = ptr->ptrSig; 
	}
}

