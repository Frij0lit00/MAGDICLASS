                		puts("Regresando al menu principal...");
               			break;
            default:
                puts("Opcion invalida");
        }
    } while(op2 != 6);
    break;
}
			default:
				puts("opcion invalida ingrese de nuevo los datos del menu");
		}
	} while(opcion != 4);

}


